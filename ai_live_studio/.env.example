# Copy this file to .env for local development and fill in real values.
# Never commit your actual .env file.

# Django
SECRET_KEY=django-insecure-CHANGE-THIS-KEY-IN-PRODUCTION-abc123xyz789
DEBUG=True

# Comma-separated extra hosts/origins if needed (Render host is auto-added)
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Database (leave empty to use local SQLite; set for PostgreSQL / Render)
# DATABASE_URL=postgres://user:password@localhost:5432/ai_live_studio

# Decart real-time face-swap API — THIS IS WHERE YOUR API KEY GOES.
# Get your key from https://platform.decart.ai (account dashboard).
# Set it and the platform activates itself automatically (AI_ENGINE_CONNECTED
# auto-detects). Leave blank to run with camera passthrough (no face swap).
DECART_API_KEY=
DECART_MODEL=lucy-2.5
FACE_SWAP_TIMEOUT_SECONDS=5

# SendGrid (admin bulk email broadcasts) — THIS IS WHERE YOUR SENDGRID API KEY GOES.
# Get it from https://app.sendgrid.com/settings/api_keys (needs "Mail Send" permission).
SENDGRID_API_KEY=
BROADCAST_FROM_EMAIL=
BROADCAST_BATCH_SIZE=500
# Leave True locally so testing never sends real email (see README).
BROADCAST_SANDBOX_MODE=True

# Email (console backend by default — prints emails to the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@ailivestudio.com
# THIS IS WHERE THE CONTACT FORM DELIVERS TO — your real inbox as the site owner
CONTACT_FORM_RECIPIENT=realoftechg@gmail.com
# Direct GitHub release download link for the Windows desktop app
WINDOWS_APP_DOWNLOAD_URL=https://github.com/YOUR_USERNAME/YOUR_REPO/releases/latest/download/CreoveyaSetup.exe
